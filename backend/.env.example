# Copia este archivo como .env y ajusta lo que necesites.
PDFEDITOR_ENVIRONMENT=development
PDFEDITOR_LOG_LEVEL=INFO
PDFEDITOR_HOST=127.0.0.1
PDFEDITOR_PORT=8000
# Lista en formato JSON
PDFEDITOR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PDFEDITOR_RATE_LIMIT_REQUESTS=120
PDFEDITOR_RATE_LIMIT_WINDOW_SECONDS=60
# Datos de idioma del OCR (relativo a backend/). Se descargan con scripts\setup-ocr.ps1
PDFEDITOR_TESSDATA_DIR=tessdata
# Traducir PDF: envía el texto a Groq. Deja la clave vacía para desactivar la herramienta.
# Consigue una clave gratis en https://console.groq.com/keys
PDFEDITOR_GROQ_API_KEY=
PDFEDITOR_GROQ_MODEL=llama-3.3-70b-versatile
